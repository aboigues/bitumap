# Modèle de configuration locale. Copier en `.env` (non versionné, voir .gitignore).
# Aucun secret ici : les clés Scaleway restent dans les profils scw (~/.config/scw/config.yaml).

# Profil scw disposant des droits d'administration de l'organisation.
# Utilisé uniquement par infra/bootstrap/bootstrap.sh.
ADMIN_PROFILE=

# Profil scw de déploiement, limité au projet BITUMAP (créé par le bootstrap).
SCW_PROFILE=bitumap

# --- Développement local (docker compose + application) ---
# Mot de passe de la base locale : générer une valeur aléatoire, par exemple
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
BITUMAP_DB_PASSWORD=
# Ports publiés sur le poste par docker compose (base, S3 simulé). Sous Windows/WSL,
# les choisir sous 49152 : la plage dynamique peut être réservée par Windows (LL-006).
BITUMAP_DB_PORT=15432
BITUMAP_S3_PORT=15000
# URL de la base locale, avec le même mot de passe et le même port :
#   postgresql://bitumap:<mot de passe>@127.0.0.1:<BITUMAP_DB_PORT>/bitumap
BITUMAP_DB_URL=
# Clés locales (valeurs aléatoires, mêmes consignes) :
BITUMAP_ALTCHA_HMAC=
BITUMAP_SEL_ORIGINE=
# En local : cookies sans « Secure » pour http://127.0.0.1
BITUMAP_COOKIES_SECURISES=false

# --- Méthode 2.0 (004), facultatif ---
# BITUMAP_METHODE=2.0 pour essayer la méthode 2.0 (défaut 1.2, seule en service).
# Compte EROS de l'USGS (température de surface) : identifiant et jeton d'application M2M
# créé dans le profil ers.cr.usgs.gov (jamais le mot de passe). Vides : « non évalué ».
BITUMAP_USGS_UTILISATEUR=
BITUMAP_USGS_JETON=
