# Modèle de configuration locale. Copier en `.env` (non versionné, voir .gitignore).
# Aucun secret ici : les clés Scaleway restent dans les profils scw (~/.config/scw/config.yaml).

# Profil scw disposant des droits d'administration de l'organisation.
# Utilisé uniquement par infra/bootstrap/bootstrap.sh.
ADMIN_PROFILE=

# Profil scw de déploiement, limité au projet BITUMAP (créé par le bootstrap).
SCW_PROFILE=bitumap
