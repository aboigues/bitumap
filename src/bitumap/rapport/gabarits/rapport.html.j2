<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="bitumap {{ version_methode }}">
<title>Risque d'orniérage — {{ commune }}</title>
<style>
:root{--fond:#eef0f2;--surface:#fff;--encre:#1c2126;--discret:#5b6570;--ligne:#d5dae0;--voie:#9aa4ae;
--commune:#e3e7eb;--accent:#9a6a00;--puce:#e6e9ed;--sel:#0a84ff;
--P1a:#9b0d1f;--P1b:#d9381e;--P1c:#b35900;--P2:#8a6d00;--P3:#3f7d4e;--sur-pastille:#fff}
@media (prefers-color-scheme:dark){:root{--fond:#15191d;--surface:#1e2328;--encre:#e8ecef;--discret:#9aa5af;
--ligne:#343b42;--voie:#5e6973;--commune:#22282e;--accent:#ebb33a;--puce:#2a3037;--sel:#3ee0ff;
--P1a:#ff5a6e;--P1b:#ff7a45;--P1c:#ffa62b;--P2:#e6d04a;--P3:#6fcf87;--sur-pastille:#15191d}}
*{box-sizing:border-box}
body{margin:0;background:var(--fond);color:var(--encre);font:15px/1.5 system-ui,"Segoe UI",sans-serif;padding:16px}
.page{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr);gap:16px}
h1{font-size:clamp(1.3rem,5vw,1.8rem);line-height:1.15;margin:0;overflow-wrap:anywhere}h2{font-size:1.2rem;margin:0 0 .5rem}
.chapeau{color:var(--discret);max-width:70ch;margin:.4rem 0 0}
.avertissement{border-left:4px solid var(--accent);background:var(--surface);padding:.6rem .8rem}
.chiffres{display:flex;flex-wrap:wrap;gap:8px}
.chiffre{background:var(--surface);border:1px solid var(--ligne);border-radius:6px;padding:8px 12px;flex:1 1 100px;min-width:0}
.chiffre b{display:block;font-size:1.5rem}.chiffre span{font-size:.75rem;color:var(--discret);text-transform:uppercase}
.chiffre span.g{text-transform:none;font-weight:600}
.niveau{border-top:5px solid var(--c)}.niveau b{color:var(--c)}
.grille{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:16px;align-items:start}
@media (max-width:860px){.grille{grid-template-columns:minmax(0,1fr)}}
.panneau{background:var(--surface);border:1px solid var(--ligne);border-radius:8px;padding:12px}
.carte{width:100%;height:auto;display:block}
.commune{fill:var(--commune);stroke:var(--ligne);stroke-width:1.5}
.voie{fill:none;stroke:var(--voie);stroke-linecap:round;opacity:.8}
.pt{cursor:pointer;transform-box:fill-box;transform-origin:center}
.pt.sel{stroke:var(--sel);stroke-width:4;paint-order:stroke;scale:1.8;
filter:drop-shadow(0 0 3px var(--sel)) drop-shadow(0 0 8px var(--sel))}
.pt:focus-visible,[data-point]:focus-visible,select:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.filtres{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
select{font:inherit;padding:4px 6px;border-radius:6px;border:1px solid var(--ligne);background:var(--puce);color:var(--encre)}
ol.liste{list-style:none;margin:0;padding:0;max-height:640px;overflow-y:auto;display:grid;gap:4px}
ol.liste li{display:grid;grid-template-columns:40px 1fr auto;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer}
ol.liste li:hover{background:var(--puce)}
ol.liste li.sel{background:var(--puce);box-shadow:inset 5px 0 0 var(--sel),0 0 0 2px var(--sel)}
.rang{color:var(--discret);font-variant-numeric:tabular-nums}.petit{font-size:.85rem;color:var(--discret)}
.pastille{font-weight:600;font-size:.75rem;padding:3px 7px;border-radius:4px;color:#fff;align-self:start;white-space:nowrap}
.P1a{--c:var(--P1a)}.P1b{--c:var(--P1b)}.P1c{--c:var(--P1c)}.P2{--c:var(--P2)}.P3{--c:var(--P3)}
.pastille{background:var(--c);color:var(--sur-pastille)}
.fiche h3{margin:.2rem 0}.fiche dl{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;margin:.5rem 0}
.fiche dt{color:var(--discret)}.fiche dd{margin:0}
.fiche h4{margin:.8rem 0 .2rem;font-size:.95rem}.constate{border-left:4px solid var(--sel);padding-left:8px}
.releve-marque{font-size:.75rem;font-weight:600;color:var(--sel);margin-left:6px}
table{border-collapse:collapse;width:100%;font-size:.9rem;overflow-wrap:anywhere}th,td{text-align:left;padding:4px 6px;border-bottom:1px solid var(--ligne)}
.legende{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:.85rem;color:var(--discret);margin-top:6px}
a{color:inherit;text-decoration-color:var(--accent)}
[hidden]{display:none!important}
</style>
</head>
<body>
<div class="page">
<header>
  <h1>Risque d'orniérage sur le réseau bus — {{ commune }}</h1>
  <p class="chapeau">Rapport généré le {{ date }} · méthode {{ version_methode }} · {{ points|length }} points
    (arrêts de bus, carrefours à feux et giratoires traversés par des lignes).</p>
</header>

<p class="avertissement" role="note">Ce rapport <strong>classe des points à relever en priorité sur le
  terrain</strong> à partir de données ouvertes. Il <strong>ne mesure pas l'état réel de la chaussée</strong>.
  Les résultats issus d'une IA sont marqués « à confirmer ».</p>

{% if avertissements %}
<section class="panneau" aria-label="Avertissements"><h2>Avertissements</h2>
  <ul>{% for a in avertissements %}<li>{{ a }}</li>{% endfor %}</ul></section>
{% endif %}

<section class="chiffres" aria-label="Synthèse">
  {% for code, libelle in libelles_groupes.items() %}<div class="chiffre niveau {{ code }}"><b>{{ synthese.groupes[code] }}</b><span class="g">{{ libelle }}{% if loop.first %} · relever en premier{% endif %}</span></div>
  {% endfor %}
  {% for type, n in synthese.types.items() %}<div class="chiffre"><b>{{ n }}</b><span>{{ type }}</span></div>{% endfor %}
</section>
<section class="chiffres" aria-label="Types de route">
  {% for route, n in synthese.routes.items() %}<div class="chiffre"><b>{{ n }}</b><span>{{ route }}</span></div>{% endfor %}
</section>

<section class="grille">
  <div class="panneau">
    {{ carte|safe }}
    <div class="legende"><span>● arrêt</span><span>◆ carrefour à feux</span><span>○ giratoire</span>
      <span>couleur = niveau</span><span>trait épais = voie très fréquentée par les bus</span></div>
    <div id="fiche" class="fiche" aria-live="polite"></div>
  </div>
  <div class="panneau">
    <div class="filtres">
      <label>Priorité <select data-filtre="priorite"><option value="tous">toutes</option>
        <option value="P1">{{ libelles_groupes.P1a }} à {{ libelles_groupes.P1c|lower }}</option>
        {% for code, libelle in libelles_groupes.items() %}<option value="{{ code }}">{{ libelle }}</option>{% endfor %}
      </select></label>
      <label>Type <select data-filtre="type"><option value="tous">tous</option>
        <option value="arret">arrêts</option><option value="feu">carrefours à feux</option>
        <option value="giratoire">giratoires</option></select></label>
      <label>Route <select data-filtre="route"><option value="tous">toutes</option>
        {% for c, l in synthese.classements %}<option value="{{ c }}">{{ l }}</option>{% endfor %}
      </select></label>
      <label>Constaté <select data-filtre="constate"><option value="tous">tous</option>
        <option value="releves">relevés</option><option value="non_releves">non relevés</option>
        <option value="marque_grave">marqué ou grave</option><option value="absent">absent</option>
        <option value="leger">léger</option><option value="marque">marqué</option>
        <option value="grave">grave</option></select></label>
      <span id="compte" class="petit"></span>
    </div>
    <ol class="liste">
    {% for p in points %}
      <li data-point="{{ p.id }}" tabindex="0">
        <span class="rang">{{ p.rang }}</span>
        <span><strong>{{ p|designation }}</strong><br><span class="petit">{{ p.libelle_type }}
          · {{ p.route.classement|route }}{% if p.route.numero %} {{ p.route.numero }}{% endif %}
          · {{ p|identifiant }}</span></span>
        <span class="pastille {{ p.groupe }}">{{ libelles_groupes[p.groupe] }}</span>
      </li>
    {% endfor %}
    </ol>
  </div>
</section>

<section class="panneau" id="synthese-constate" hidden aria-label="Constaté sur le terrain">
  <h2>Constaté sur le terrain</h2>
  <p class="petit" id="constate-resume"></p>
  <table><thead><tr><th>Niveau estimé</th><th>absent</th><th>léger</th><th>marqué</th><th>grave</th></tr></thead>
    <tbody id="constate-tableau"></tbody></table>
  <p class="petit">Relevés saisis sur le terrain ; ils ne modifient ni le score ni le classement.</p>
</section>

<section class="panneau"><h2>Méthode {{ version_methode }}</h2>
  <p>Score = produit de facteurs ; niveaux par rang : les 20 % de points les plus exposés, découpés en
    trois tiers <strong>{{ libelles_groupes.P1a }}</strong>, <strong>{{ libelles_groupes.P1b }}</strong> et
    <strong>{{ libelles_groupes.P1c }}</strong> ; les 40 % suivants <strong>{{ libelles_groupes.P2 }}</strong> ; le reste
    <strong>{{ libelles_groupes.P3 }}</strong>. Ces niveaux sont fixés <em>avant</em> l'âge de l'enrobé estimé par IA,
    qui ne réordonne les points qu'à l'intérieur des 20 % les plus exposés.</p>
  <table><thead><tr><th>Facteur</th><th>Effet</th></tr></thead><tbody>
    <tr><td>Charge : passages de bus par jour (moyenne hebdomadaire hors vacances), échelle logarithmique ;
      carrefour : voie la plus chargée + moitié de la seconde</td><td>ln(1 + bus/jour)</td></tr>
    <tr><td>Sollicitation : arrêt / carrefour à feux / giratoire ; arrêt à moins de 40 m d'un carrefour à feux ;
      20 bus/h ou plus en pointe</td><td>×1,0 / ×0,8 / ×0,7 ; ×1,2 ; ×1,1</td></tr>
    <tr><td>Site : pente ≥ 3 % (±30 m le long de la voie) ; béton ou pavés</td><td>jusqu'à ×1,32 ; ×0,5</td></tr>
    <tr><td>Ensoleillement de la chaussée, 8 h–20 h mi-juillet (ombres des bâtiments, des arbres, des ponts
      et passerelles) ; arrêt : moyenne sur les 12 m où le bus s'arrête</td><td>×0,8 à ×1,2</td></tr>
    <tr><td>Îlot de chaleur, aléa de jour (0–16)</td><td>×0,92 à ×1,08</td></tr>
    <tr><td>Âge de l'enrobé (IA, 20 % les plus exposés seulement, à confirmer) : refait il y a 5–12 ans ; plus de 12 ans</td><td>×0,85 ; ×1,05</td></tr>
  </tbody></table>
  <h3>Limites connues</h3>
  <ul>
    <li>Le score classe des points ; il ne mesure pas l'état de la chaussée.</li>
    <li>Ensoleillement : arbres et tabliers de hauteur forfaitaire, sans relief, zone d'arrêt en ligne droite
      (à approfondir).</li>
    <li>Îlots de chaleur : indicateur de jour de 2022 (à approfondir).</li>
    <li>Trafic poids lourds hors bus non compté ; lignes sans arrêt dans la commune non comptées.</li>
    <li>Type de route : classement IGN recoupé avec OpenStreetMap ; « à vérifier » en cas de divergence.</li>
    <li>Âge de l'enrobé estimé par IA sur orthophotos : à confirmer sur le terrain.</li>
  </ul>
</section>

<section class="panneau"><h2>Sources</h2>
  <table><thead><tr><th>Source</th><th>Licence</th><th>Date d'extraction</th></tr></thead><tbody>
  {% for s in sources %}<tr><td><a href="{{ s.url }}" rel="noopener noreferrer">{{ s.nom }}</a></td>
    <td>{{ s.licence }}</td><td>{{ s.date_extraction }}</td></tr>{% endfor %}
  </tbody></table>
  {% if ia %}<p class="petit">Âge de l'enrobé : modèle {{ ia.modele }} (Scaleway Generative APIs, hébergé en France),
    prompt {{ ia.version_prompt }} ; {{ ia.appels }} analyse(s), {{ ia.succes_cache }} depuis le cache.</p>{% endif %}
  <p class="petit">Rapport destiné à son demandeur et à la collectivité concernée.</p>
</section>
</div>

<template id="gabarit-fiche">
  <h3 class="f-titre"></h3><div class="petit f-sous"></div>
  <h4>Constaté</h4><div class="constate f-constate"></div>
  <h4>Estimé</h4>
  <dl><dt>Classement</dt><dd class="f-rang"></dd><dt>Route</dt><dd class="f-route"></dd>
    <dt>Bus</dt><dd class="f-bus"></dd><dt>Lignes</dt><dd class="f-lignes"></dd>
    <dt>Photo</dt><dd class="f-photo"></dd></dl>
  <strong>Facteurs</strong><ul class="f-facteurs"></ul>
</template>
<script type="application/json" id="donnees">{{ donnees_json|safe }}</script>
<script>{{ script|safe }}</script>
</body>
</html>
