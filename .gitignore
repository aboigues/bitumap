# OpenTofu : état et fichiers locaux (principe « Contraintes techniques » : état jamais commité)
*.tfstate
*.tfstate.*
.terraform/
*.tfplan
crash.log

# Sorties des scanners et artefacts locaux
*.sarif
*.cdx.json
__pycache__/
*.pyc
.venv/

# Variables locales (jamais de secret versionné) : seul .env.example est suivi
.env
.env.*
!.env.example

# Python : environnements et caches
.venv/
.pytest_cache/
.ruff_cache/
var/

# Outils locaux
.playwright-mcp/

# OpenTofu : fichiers locaux (le verrou des fournisseurs, lui, est versionné)
.terraform/
*.tfvars
*.tfvars.sauvegarde
!*.tfvars.example
